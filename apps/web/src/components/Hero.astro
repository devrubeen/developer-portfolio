  <!-- Vertical side label -->
  <div class="absolute bottom-32 left-3 hidden -rotate-90 origin-left lg:block">
    <span class="text-[8px] uppercase tracking-[0.4em] text-neutral-800">
      RLM / Digital Craft
    </span>
  </div>


  <!-- Animation -->
  <style>
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(32px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

