
---
const technologies = [
  "React",
  "Next.js",
  "Astro",
  "TypeScript",
  "Node.js",
  "Tailwind CSS",
];
---

<section
  id="home"
  class="relative isolate flex min-h-screen items-center overflow-hidden bg-[var(--background)] px-6 pb-20 pt-36 lg:px-8"
>
  <!-- Ambient effects -->
  <div
    class="pointer-events-none absolute -right-40 top-10 h-[600px] w-[600px] rounded-full bg-violet-500/15 blur-[130px] dark:bg-violet-600/20"
  ></div>

  <div
    class="pointer-events-none absolute -left-48 bottom-0 h-[450px] w-[450px] rounded-full bg-indigo-500/10 blur-[120px]"
  ></div>

  <!-- Background grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035] dark:opacity-[0.055]"
    style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 64px 64px;"
  ></div>

  <div class="relative mx-auto grid w-full max-w-7xl items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">

    <!-- Left content -->
    <div class="hero-reveal relative z-10">

      <div
        class="mb-8 inline-flex items-center gap-3 rounded-full border border-violet-500/20 bg-violet-500/5 px-4 py-2 text-xs font-medium text-violet-600 dark:text-violet-300"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inset-0 animate-ping rounded-full bg-emerald-400 opacity-50"></span>
          <span class="relative h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        Full Stack Developer
      </div>

      <p class="mb-4 text-lg font-medium text-[var(--muted)] sm:text-xl">
        Hello, I'm
      </p>

      <h1 class="max-w-3xl text-[clamp(3.5rem,6.5vw,6.5rem)] font-extrabold leading-[1.06] tracking-[-0.065em]">
        Rubén
        <span class="block bg-gradient-to-r from-violet-600 via-purple-500 to-indigo-500 bg-clip-text text-transparent">
          Lora Martín.
        </span>
      </h1>

      <h2 class="mt-7 text-xl font-semibold tracking-tight sm:text-2xl">
        Building digital
        <span class="text-violet-500">experiences.</span>
      </h2>

      <p class="mt-6 max-w-xl text-base leading-8 text-[var(--muted)]">
        I design and develop modern websites, intuitive interfaces
        and scalable full-stack applications. Combining creativity,
        clean code and thoughtful user experiences.
      </p>

      <!-- Actions -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="group inline-flex items-center gap-3 rounded-xl bg-violet-600 px-7 py-4 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition duration-300 hover:-translate-y-1 hover:bg-violet-700"
        >
          View My Work
          <span class="transition-transform group-hover:translate-x-1">↗</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--surface)] px-7 py-4 text-sm font-semibold transition duration-300 hover:-translate-y-1 hover:border-violet-500"
        >
          Let's Talk
          <span>→</span>
        </a>
      </div>

      <!-- Tech stack -->
      <div class="mt-16 border-t border-[var(--border-color)] pt-8">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">
          Technologies I work with
        </p>

        <div class="flex flex-wrap gap-3">
          {technologies.map((tech) => (
            <span
              class="rounded-lg border border-[var(--border-color)] bg-[var(--surface)] px-3 py-2 text-xs font-medium text-[var(--muted)] transition hover:border-violet-500 hover:text-violet-500"
            >
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Right visual -->
    <div class="hero-reveal relative mx-auto w-full max-w-[570px] lg:ml-auto">

      <!-- Main glow -->
      <div
        class="pointer-events-none absolute inset-10 rounded-full bg-violet-600/20 blur-[90px]"
      ></div>

      <!-- Floating badge -->
      <div
        class="float-slow absolute -top-8 right-2 z-20 rounded-2xl border border-[var(--border-color)] bg-[var(--surface)] px-5 py-3 shadow-xl sm:right-0"
      >
        <div class="flex items-center gap-3">
          <span class="text-2xl">⚡</span>
          <div>
            <p class="text-xs font-bold">Creative Development</p>
            <p class="text-[11px] text-[var(--muted)]">Design meets code</p>
          </div>
        </div>
      </div>

      <!-- Editor -->
      <div
        class="relative z-10 overflow-hidden rounded-2xl border border-[var(--border-color)] bg-[#10101b] shadow-[0_35px_100px_-25px_rgba(109,40,217,0.35)]"
      >
        <!-- Editor header -->
        <div class="flex items-center justify-between border-b border-white/10 bg-[#171725] px-5 py-4">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>

          <span class="font-mono text-xs text-slate-400">
            developer.ts
          </span>

          <span class="text-xs text-slate-500">⌘</span>
        </div>

        <!-- Editor code -->
        <div class="overflow-x-auto px-5 py-8 font-mono text-[12px] leading-[2.2] sm:px-8 sm:text-sm">
          <div><span class="text-violet-400">const</span> <span class="text-blue-300">developer</span> <span class="text-white">= &#123;</span></div>

          <div class="pl-5"><span class="text-sky-300">name</span><span class="text-white">:</span> <span class="text-emerald-300">"Rubén Lora Martín"</span><span class="text-white">,</span></div>

          <div class="pl-5"><span class="text-sky-300">role</span><span class="text-white">:</span> <span class="text-emerald-300">"Full Stack Developer"</span><span class="text-white">,</span></div>

          <div class="pl-5"><span class="text-sky-300">passion</span><span class="text-white">:</span> <span class="text-emerald-300">"Building the web"</span><span class="text-white">,</span></div>

          <div class="pl-5"><span class="text-sky-300">skills</span><span class="text-white">: [</span></div>

          <div class="pl-10 text-emerald-300">"Frontend",</div>
          <div class="pl-10 text-emerald-300">"Backend",</div>
          <div class="pl-10 text-emerald-300">"UI / UX"</div>

          <div class="pl-5 text-white">],</div>

          <div class="pl-5"><span class="text-sky-300">available</span><span class="text-white">:</span> <span class="text-orange-300">true</span></div>

          <div class="text-white">&#125;;</div>

          <div class="mt-5">
            <span class="text-violet-400">export default</span>
            <span class="text-blue-300">developer</span><span class="text-white">;</span>
          </div>
        </div>

        <!-- Editor status -->
        <div class="flex items-center justify-between border-t border-white/10 bg-[#171725] px-5 py-3 font-mono text-[10px] text-slate-400">
          <span>TypeScript</span>
          <span>UTF-8 · Ready to build</span>
        </div>
      </div>

      <!-- Bottom floating badge -->
      <div
        class="float-slow-delayed absolute -bottom-8 -left-2 z-20 rounded-2xl border border-[var(--border-color)] bg-[var(--surface)] px-5 py-4 shadow-xl sm:-left-8"
      >
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-500/10 text-xl text-violet-500">
            &lt;/&gt;
          </span>
          <div>
            <p class="text-xs font-bold">Clean Code</p>
            <p class="text-[11px] text-[var(--muted)]">Modern solutions</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#projects"
    aria-label="Scroll to projects"
    class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 animate-bounce text-2xl text-[var(--muted)] xl:block"
  >
    ↓
  </a>
</section>

<style>
  .hero-reveal {
    animation: heroReveal 900ms ease-out both;
  }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .float-slow {
    animation: floating 5s ease-in-out infinite;
  }

  .float-slow-delayed {
    animation: floating 6s ease-in-out 1s infinite;
  }

  @keyframes floating {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .float-slow,
    .float-slow-delayed {
      animation: none;
    }
  }
</style>
