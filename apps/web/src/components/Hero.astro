            <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500 transition-colors duration-300 group-hover:text-white">
              Explore selected work
            </span>

            <span
              class="flex h-12 w-12 items-center justify-center rounded-full border border-neutral-800 text-lg text-neutral-500 transition-all duration-500 group-hover:border-lime-400 group-hover:bg-lime-400 group-hover:text-black"
            >
              ↘
            </span>
