
---

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section
  id="contact"
  class="relative isolate overflow-hidden border-t border-[var(--border-color)] bg-[var(--background)] px-6 pt-28 lg:px-8 lg:pt-36"
>
  <!-- Background effects -->
  <div
    class="pointer-events-none absolute left-1/2 top-20 h-[650px] w-[850px] -translate-x-1/2 rounded-full bg-violet-600/[0.08] blur-[140px]"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <!-- Section heading -->
    <div class="mb-16 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <div data-reveal class="mb-6 flex items-center gap-3">
          <span class="h-px w-8 bg-violet-500"></span>
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-violet-500">
            Have something in mind?
          </span>
        </div>

        <h2  data-reveal class="text-[clamp(3.5rem,8vw,8rem)] font-extrabold leading-[1.02] tracking-[-0.08em]">
          Let's create
          <span class="block">
            something
            <span class="bg-gradient-to-r from-violet-600 via-purple-500 to-indigo-500 bg-clip-text text-transparent">
              great.
            </span>
          </span>
        </h2>
      </div>

      <p data-reveal class="max-w-xs text-sm leading-8 text-[var(--muted)] sm:text-base">
        Have a project, an idea or just want to connect?
        I'm always interested in hearing about new
        opportunities and creative challenges.
      </p>
    </div>
    
<!-- Contact panel -->
<div
  data-reveal
  class="grid gap-12 rounded-3xl border border-[var(--border-color)] bg-[var(--surface)] p-7 sm:p-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:p-14"
>
  <!-- Left side -->
  <div class="flex flex-col justify-between">
    <div>
      <div class="mb-7 flex items-center gap-3">
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">
          Let's connect
        </span>
      </div>

      <h3 data-reveal class="text-3xl font-bold leading-tight tracking-[-0.05em] sm:text-5xl">
        Tell me about
        <span class="block text-violet-500">your idea.</span>
      </h3>

      <p data-reveal class="mt-6 max-w-sm text-sm leading-8 text-[var(--muted)]">
        Have a project in mind, a collaboration opportunity
        or just want to say hello? Fill out the form and
        your message will land directly in my inbox.
      </p>
    </div>

    <div class="mt-12 flex items-center gap-4 border-t border-[var(--border-color)] pt-7">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/10 text-xl text-violet-500">
        ↗
      </div>

      <div>
        <p class="text-sm font-semibold">Direct communication</p>
        <p class="mt-1 text-xs text-[var(--muted)]">
          No redirects. Just your message.
        </p>
      </div>
    </div>
  </div>

  <!-- Form -->
  <form id="contact-form" class="space-y-6">
    <!-- Honeypot: hidden from normal visitors -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="contact-name" class="mb-2 block text-xs font-semibold">
          Your name <span class="text-violet-500">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          maxlength="100"
          autocomplete="name"
          placeholder="John Doe"
          class="w-full rounded-xl border border-[var(--border-color)] bg-[var(--background)] px-4 py-3.5 text-sm text-[var(--foreground)] outline-none transition placeholder:text-[var(--muted)] focus:border-violet-500 focus:ring-2 focus:ring-violet-500/10"
        />
      </div>

      <div>
        <label for="contact-email" class="mb-2 block text-xs font-semibold">
          Email address <span class="text-violet-500">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="john@example.com"
          class="w-full rounded-xl border border-[var(--border-color)] bg-[var(--background)] px-4 py-3.5 text-sm text-[var(--foreground)] outline-none transition placeholder:text-[var(--muted)] focus:border-violet-500 focus:ring-2 focus:ring-violet-500/10"
        />
      </div>
    </div>

    <div>
      <label for="contact-subject" class="mb-2 block text-xs font-semibold">
        Subject <span class="text-violet-500">*</span>
      </label>
      <input
        id="contact-subject"
        name="subject"
        type="text"
        required
        maxlength="150"
        placeholder="Let's work together"
        class="w-full rounded-xl border border-[var(--border-color)] bg-[var(--background)] px-4 py-3.5 text-sm text-[var(--foreground)] outline-none transition placeholder:text-[var(--muted)] focus:border-violet-500 focus:ring-2 focus:ring-violet-500/10"
      />
    </div>

    <div>
      <label for="contact-message" class="mb-2 block text-xs font-semibold">
        Your message <span class="text-violet-500">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        minlength="10"
        maxlength="5000"
        rows="6"
        placeholder="Tell me a little about your project..."
        class="w-full resize-y rounded-xl border border-[var(--border-color)] bg-[var(--background)] px-4 py-3.5 text-sm leading-7 text-[var(--foreground)] outline-none transition placeholder:text-[var(--muted)] focus:border-violet-500 focus:ring-2 focus:ring-violet-500/10"
      ></textarea>
    </div>

    <!-- Cloudflare Turnstile -->
    <div class="space-y-2">
    <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="auto"
        data-size="flexible"
    ></div>

    <p class="text-xs text-[var(--muted)]">
        Protected by Cloudflare Turnstile.
    </p>
    </div>

    <div
      id="contact-feedback"
      role="status"
      aria-live="polite"
      class="hidden rounded-xl px-4 py-3 text-sm"
    ></div>

    <button
      id="contact-submit"
      type="submit"
      class="group flex w-full items-center justify-center gap-3 rounded-xl bg-violet-600 px-6 py-4 text-sm font-semibold text-white transition duration-300 hover:bg-violet-700 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span id="contact-button-text">Send Message</span>
      <span class="transition-transform group-hover:translate-x-1">↗</span>
    </button>

    <p class="text-center text-xs text-[var(--muted)]">
      Your message will be sent securely to my inbox.
    </p>
  </form>
</div>

  </div>
</section>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  interface TurnstileAPI {
    reset: () => void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileAPI;
    }
  }

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const button = document.querySelector<HTMLButtonElement>("#contact-submit");
  const buttonText = document.querySelector<HTMLElement>("#contact-button-text");
  const feedback = document.querySelector<HTMLElement>("#contact-feedback");

  if (form && button && buttonText && feedback) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      button.disabled = true;
      buttonText.textContent = "Sending...";
      feedback.classList.add("hidden");

      try {
        const formData = new FormData(form);

        const turnstileToken = String(
          formData.get("cf-turnstile-response") ?? ""
        );

        if (!turnstileToken) {
          throw new Error(
            "Please complete the security verification."
          );
        }

        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(
            Object.fromEntries(formData.entries())
          ),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.error || "Something went wrong."
          );
        }

        feedback.textContent =
          "Message sent successfully! Thank you for reaching out.";

        feedback.className =
          "rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400";

        form.reset();
      } catch (error) {
        feedback.textContent =
          error instanceof Error
            ? error.message
            : "Unable to send the message.";

        feedback.className =
          "rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-500";
      } finally {
        window.turnstile?.reset();
        button.disabled = false;
        buttonText.textContent = "Send Message";
      }
    });
  }
</script>


