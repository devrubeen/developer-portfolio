
---
interface Props {
  number: string;
  title: string;
  category: string;
  year: string;
  tags: string[];
  description: string;
  status?: string;
  href?: string;
  github?: string;
  visual?: "workspace" | "experience" | "portfolio";
  featured?: boolean;
  reverse?: boolean;
}

const {
  number,
  title,
  category,
  year,
  tags,
  description,
  status = "In development",
  href,
  github,
  visual = "workspace",
  featured = false,
  reverse = false,
} = Astro.props;
---

<article
  data-project
  class:list={[
    "project-card group relative grid items-center gap-8 border-b border-[var(--border-color)] py-12 lg:gap-16 lg:py-20",
    featured
      ? "lg:grid-cols-[1.15fr_0.85fr]"
      : "lg:grid-cols-2",
  ]}
>
  <!-- Preview -->
  <div
  class:list={[
    "relative min-w-0 overflow-hidden rounded-2xl border border-[var(--border-color)] bg-[#10101b] shadow-xl transition-shadow duration-500 group-hover:shadow-violet-600/10",
    reverse && "lg:order-2",
  ]}
>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(124,58,237,0.22),transparent_70%)]"
    ></div>

    <div
  data-project-visual
  class="relative flex aspect-[4/3] items-center justify-center p-6 sm:p-10"
>

      {visual === "workspace" && (
        <div class="w-full max-w-[490px] rotate-[-3deg] overflow-hidden rounded-xl border border-white/10 bg-[#181827] shadow-2xl transition-transform duration-700 group-hover:rotate-0 group-hover:scale-[1.03]">
          <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
            <span class="h-2 w-2 rounded-full bg-red-400"></span>
            <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
            <span class="h-2 w-2 rounded-full bg-green-400"></span>
            <span class="ml-4 text-[10px] text-slate-400">AI Workspace</span>
          </div>

          <div class="p-5">
            <p class="text-[10px] text-violet-400">YOUR WORKSPACE</p>
            <p class="mt-2 text-xl font-bold text-white">Project Overview</p>

            <div class="mt-5 grid grid-cols-3 gap-2">
              {["To do", "In progress", "Done"].map((column, i) => (
                <div class="rounded-lg bg-white/5 p-2">
                  <p class="mb-3 text-[9px] text-slate-300">{column}</p>
                  {Array.from({ length: i === 1 ? 2 : 3 }).map(() => (
                    <div class="mb-2 rounded bg-white/[0.07] p-2">
                      <div class="h-1.5 w-4/5 rounded bg-violet-400/50"></div>
                      <div class="mt-2 h-1 w-2/3 rounded bg-white/15"></div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {visual === "experience" && (
        <div class="flex w-full max-w-[440px] flex-col items-center rounded-2xl border border-red-500/20 bg-[#0a0a0a] px-6 py-12 text-center shadow-2xl transition-transform duration-700 group-hover:scale-[1.04]">
          <div class="mb-6 h-2 w-2 animate-pulse rounded-full bg-red-500"></div>

          <p class="font-mono text-[10px] uppercase tracking-[0.35em] text-red-400">
            System initialized
          </p>

          <h4 class="mt-5 text-3xl font-black tracking-tighter text-white sm:text-5xl">
            PACO<span class="text-red-500">SYSTEM</span>
          </h4>

          <p class="mt-2 font-mono text-xs text-neutral-500">
            VERSION 50.0
          </p>

          <div class="mt-8 rounded border border-red-500/40 px-5 py-2 font-mono text-[10px] text-red-400">
            EXPERIENCE LOADED
          </div>
        </div>
      )}

      {visual === "portfolio" && (
        <div class="w-full max-w-[450px] rotate-[3deg] rounded-xl border border-white/10 bg-[#171627] p-7 shadow-2xl transition-transform duration-700 group-hover:rotate-0 group-hover:scale-[1.03]">
          <div class="mb-8 flex items-center justify-between">
            <span class="text-sm font-bold text-white">
              Rubén<span class="text-violet-400">.</span>
            </span>
            <span class="text-[9px] text-slate-400">PORTFOLIO / 2026</span>
          </div>

          <p class="text-xs text-slate-400">Hello, I'm</p>

          <p class="mt-2 text-4xl font-extrabold tracking-tight text-white">
            Rubén
          </p>

          <p class="text-4xl font-extrabold tracking-tight text-violet-400">
            Lora Martín.
          </p>

          <p class="mt-5 text-xs text-slate-400">
            Full Stack Developer
          </p>

          <div class="mt-7 inline-block rounded-lg bg-violet-600 px-4 py-2 text-[10px] font-semibold text-white">
            View My Work ↗
          </div>
        </div>
      )}
    </div>

    <div class="absolute bottom-5 left-6 font-mono text-[10px] uppercase tracking-widest text-white/40">
      Project preview / {number}
    </div>
  </div>

  <!-- Information -->
  <div class:list={["flex flex-col", reverse && "lg:order-1"]}>
    <div class="mb-7 flex flex-wrap items-center gap-3">
      <span class="font-mono text-xs font-bold text-violet-500">
        / {number}
      </span>

      <span class="h-px w-8 bg-[var(--border-color)]"></span>

      <span class="text-xs font-semibold uppercase tracking-widest text-[var(--muted)]">
        {category}
      </span>
    </div>

    <h3
      class:list={[
        "font-extrabold leading-[1.1] tracking-[-0.06em]",
        featured
          ? "text-4xl sm:text-5xl xl:text-6xl"
          : "text-4xl sm:text-5xl",
      ]}
    >
      {title}<span class="text-violet-500">.</span>
    </h3>

    <p class="mt-6 max-w-xl text-sm leading-8 text-[var(--muted)] sm:text-base">
      {description}
    </p>

    <div class="mt-8 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full border border-[var(--border-color)] bg-[var(--surface)] px-4 py-2 text-xs font-medium transition-colors hover:border-violet-500 hover:text-violet-500">
          {tag}
        </span>
      ))}
    </div>

    <div class="mt-8 flex items-center gap-3 text-xs text-[var(--muted)]">
      <span class="h-2 w-2 rounded-full bg-violet-500"></span>
      <span>{status}</span>
      <span class="mx-1">·</span>
      <span>{year}</span>
    </div>

    <!-- Actions -->
    <div class="mt-10 flex flex-wrap gap-3">
      {href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link inline-flex items-center gap-3 rounded-xl bg-violet-600 px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-1 hover:bg-violet-700"
        >
          Live Preview
          <span class="transition-transform group-hover/link:translate-x-1">↗</span>
        </a>
      )}

      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--surface)] px-6 py-3.5 text-sm font-semibold transition hover:-translate-y-1 hover:border-violet-500"
        >
          GitHub ↗
        </a>
      )}

      {!href && !github && (
        <span class="text-xs italic text-[var(--muted)]">
          Project links coming soon
        </span>
      )}
    </div>
  </div>
</article>
