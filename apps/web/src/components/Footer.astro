
---
const github = "https://github.com/devrubeen";

const linkedin =
  "https://www.linkedin.com/in/rub%C3%A9n-lora-mart%C3%ADn-054538216/";

const socialLinks = [
  { label: "GitHub", href: github },
  { label: "LinkedIn", href: linkedin },
];

const year = new Date().getFullYear();
---

<footer
  class="border-t border-[var(--border-color)] bg-[var(--background)] px-6 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- Social links -->
    <div
      data-reveal
      class="grid gap-8 border-b border-[var(--border-color)] py-14 md:grid-cols-2"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-500"
        >
          Find me online
        </p>

        <p class="mt-3 text-sm text-[var(--muted)]">
          Explore my code and connect with me.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 md:justify-end">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold transition-all duration-300 hover:-translate-y-1 hover:border-violet-500 hover:text-violet-500"
          >
            {link.label}
            <span
              class="transition-transform group-hover:translate-x-1"
            >
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom footer -->
    <div
      data-reveal
      class="flex flex-col gap-6 py-9 sm:flex-row sm:items-center sm:justify-between"
    >
      <a
        href="#home"
        class="text-xl font-extrabold tracking-tight"
      >
        Rubén<span class="text-violet-500">.</span>
      </a>

      <p class="text-xs text-[var(--muted)]">
        © {year} Rubén Lora Martín.
        Built with Astro & Tailwind CSS.
      </p>

      <a
        href="#home"
        class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--muted)] transition hover:text-violet-500"
      >
        Back to top ↑
      </a>
    </div>

  </div>
</footer>
