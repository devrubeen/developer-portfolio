---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Portfolio">
	<main>
		<section class="hero">
			<p class="eyebrow">Hola, soy</p>

			<h1>Tu Nombre</h1>

			<h2>Desarrollador Web</h2>

			<p class="intro">
				Construyo experiencias web modernas, rápidas y atractivas.
			</p>

			<div class="actions">
				<a href="#proyectos">Ver proyectos</a>
				<a href="#contacto" class="secondary">Contactar</a>
			</div>
		</section>

		<section id="proyectos">
			<h2>Proyectos</h2>
			<p>Aquí mostraremos tus proyectos próximamente.</p>
		</section>

		<section id="contacto">
			<h2>Contacto</h2>
			<p>Hablemos sobre tu próximo proyecto.</p>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 2rem;
	}

	.hero {
		min-height: 80vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.eyebrow {
		margin: 0;
		font-weight: 700;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 6rem);
		margin: 0.25rem 0;
	}

	.hero h2 {
		font-size: clamp(1.5rem, 4vw, 2.5rem);
		margin: 0 0 1rem;
	}

	.intro {
		max-width: 600px;
		font-size: 1.2rem;
		line-height: 1.6;
	}

	.actions {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	a {
		display: inline-block;
		padding: 0.8rem 1.2rem;
		border-radius: 8px;
		background: #111;
		color: white;
		text-decoration: none;
	}

	a.secondary {
		background: transparent;
		color: inherit;
		border: 1px solid currentColor;
	}

	section:not(.hero) {
		padding: 5rem 0;
	}
</style>